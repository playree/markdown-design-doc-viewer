{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Markdown Design Doc Viewer",
  "mainBinaryName": "markdown-design-doc-viewer",
  "version": "../../package.json",
  "identifier": "io.github.playree.mddesigndoc",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": {
      "script": "pnpm desktop:build",
      "wait": true
    },
    "beforeBuildCommand": "pnpm desktop:build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Markdown Design Doc Viewer",
        "width": 1200,
        "height": 800,
        "minWidth": 400,
        "minHeight": 300
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https: data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "playree",
    "copyright": "Copyright (c) 2026 playree",
    "license": "MIT",
    "homepage": "https://github.com/playree/markdown-design-doc-viewer",
    "category": "DeveloperTool",
    "shortDescription": "Viewer of design documents in Markdown with mermaid diagrams",
    "longDescription": "Preview design documents written in Markdown: mermaid sequence diagrams and flowcharts side by side with their linked step descriptions, a document header from the front matter, a table of contents, GitHub alerts and task lists.",
    "resources": {
      "../../LICENSE": "LICENSE",
      "../../ThirdPartyNotices.txt": "ThirdPartyNotices.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
