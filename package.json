{
  "name": "markdown-design-doc-viewer",
  "displayName": "Markdown Design Doc Viewer",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "playree",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/playree/markdown-design-doc-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/playree/markdown-design-doc-viewer/issues"
  },
  "homepage": "https://github.com/playree/markdown-design-doc-viewer#readme",
  "icon": "images/icon.png",
  "l10n": "./l10n",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "markdown",
    "mermaid",
    "sequence diagram",
    "design document",
    "preview"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:markdown",
    "onWebviewPanel:mdDesignDoc.preview"
  ],
  "contributes": {
    "commands": [
      {
        "command": "mdDesignDoc.openPreview",
        "title": "%mdDesignDoc.openPreview.title%",
        "category": "%category%",
        "icon": "$(open-preview)"
      },
      {
        "command": "mdDesignDoc.openPreviewToSide",
        "title": "%mdDesignDoc.openPreviewToSide.title%",
        "category": "%category%",
        "icon": "$(open-preview)"
      }
    ],
    "customEditors": [
      {
        "viewType": "mdDesignDoc.editor",
        "displayName": "%mdDesignDoc.editor.displayName%",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "option"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mdDesignDoc.openPreviewToSide",
          "when": "editorLangId == markdown",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "mdDesignDoc.openPreview",
          "when": "editorLangId == markdown"
        },
        {
          "command": "mdDesignDoc.openPreviewToSide",
          "when": "editorLangId == markdown"
        }
      ]
    },
    "configuration": {
      "title": "Markdown Design Doc Viewer",
      "properties": {
        "mdDesignDoc.splitMinWidth": {
          "type": "number",
          "default": 1000,
          "minimum": 0,
          "description": "%mdDesignDoc.splitMinWidth.description%"
        },
        "mdDesignDoc.syncEditor": {
          "type": "boolean",
          "default": true,
          "description": "%mdDesignDoc.syncEditor.description%"
        },
        "mdDesignDoc.toc": {
          "type": "boolean",
          "default": true,
          "description": "%mdDesignDoc.toc.description%"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "vscode:prepublish": "node esbuild.mjs --production",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.2",
    "mermaid": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.100.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.3.4"
}
