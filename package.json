{
  "name": "markdown-design-doc-viewer",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.3.0",
  "publisher": "playree",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/playree/markdown-design-doc-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/playree/markdown-design-doc-viewer/issues"
  },
  "homepage": "https://github.com/playree/markdown-design-doc-viewer#readme",
  "icon": "images/icon.png",
  "l10n": "./l10n",
  "engines": {
    "vscode": "^1.100.0",
    "node": ">=22"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "markdown",
    "mermaid",
    "sequence diagram",
    "flowchart",
    "design document",
    "preview",
    "design doc",
    "specification",
    "documentation",
    "docs as code",
    "architecture",
    "uml",
    "sequence",
    "mermaid preview",
    "markdown preview",
    "html export",
    "front matter",
    "git diff",
    "設計書",
    "仕様書",
    "基本設計書",
    "詳細設計書",
    "シーケンス図",
    "フローチャート",
    "電文定義"
  ],
  "main": "./dist/extension.js",
  "bin": {
    "md-design-doc": "dist/cli.js"
  },
  "activationEvents": [
    "onLanguage:markdown",
    "onWebviewPanel:mdDesignDoc.preview",
    "onWebviewPanel:mdDesignDoc.designDocs"
  ],
  "contributes": {
    "commands": [
      {
        "command": "mdDesignDoc.openPreview",
        "title": "%mdDesignDoc.openPreview.title%",
        "category": "%category%",
        "icon": "$(open-preview)"
      },
      {
        "command": "mdDesignDoc.openPreviewToSide",
        "title": "%mdDesignDoc.openPreviewToSide.title%",
        "category": "%category%",
        "icon": "$(open-preview)"
      },
      {
        "command": "mdDesignDoc.exportHtml",
        "title": "%mdDesignDoc.exportHtml.title%",
        "category": "%category%"
      },
      {
        "command": "mdDesignDoc.useFullContentWidth",
        "title": "%mdDesignDoc.useFullContentWidth.title%",
        "category": "%category%",
        "icon": "$(screen-full)"
      },
      {
        "command": "mdDesignDoc.limitContentWidth",
        "title": "%mdDesignDoc.limitContentWidth.title%",
        "category": "%category%",
        "icon": "$(screen-normal)"
      },
      {
        "command": "mdDesignDoc.toggleTheme",
        "title": "%mdDesignDoc.toggleTheme.title%",
        "category": "%category%",
        "icon": "$(color-mode)"
      },
      {
        "command": "mdDesignDoc.compareWithRevision",
        "title": "%mdDesignDoc.compareWithRevision.title%",
        "category": "%category%",
        "icon": "$(history)"
      },
      {
        "command": "mdDesignDoc.showDesignDocs",
        "title": "%mdDesignDoc.showDesignDocs.title%",
        "category": "%category%",
        "icon": "$(list-flat)"
      },
      {
        "command": "mdDesignDoc.refreshDesignDocs",
        "title": "%mdDesignDoc.refreshDesignDocs.title%",
        "category": "%category%",
        "icon": "$(refresh)"
      },
      {
        "command": "mdDesignDoc.openDesignDocInEditor",
        "title": "%mdDesignDoc.openDesignDocInEditor.title%",
        "category": "%category%",
        "icon": "$(go-to-file)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "mdDesignDoc.designDocs",
          "name": "%mdDesignDoc.designDocs.name%",
          "when": "workspaceFolderCount > 0",
          "icon": "$(list-flat)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "mdDesignDoc.designDocs",
        "contents": "%mdDesignDoc.designDocs.welcome%"
      }
    ],
    "customEditors": [
      {
        "viewType": "mdDesignDoc.editor",
        "displayName": "%mdDesignDoc.editor.displayName%",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "option"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mdDesignDoc.openPreviewToSide",
          "when": "editorLangId == markdown",
          "group": "navigation"
        },
        {
          "command": "mdDesignDoc.useFullContentWidth",
          "when": "(activeWebviewPanelId == 'mdDesignDoc.preview' || activeCustomEditorId == 'mdDesignDoc.editor') && config.mdDesignDoc.limitContentWidth",
          "group": "navigation"
        },
        {
          "command": "mdDesignDoc.limitContentWidth",
          "when": "(activeWebviewPanelId == 'mdDesignDoc.preview' || activeCustomEditorId == 'mdDesignDoc.editor') && !config.mdDesignDoc.limitContentWidth",
          "group": "navigation"
        },
        {
          "command": "mdDesignDoc.toggleTheme",
          "when": "activeWebviewPanelId == 'mdDesignDoc.preview' || activeCustomEditorId == 'mdDesignDoc.editor' || activeWebviewPanelId == 'mdDesignDoc.designDocs'",
          "group": "navigation"
        },
        {
          "command": "mdDesignDoc.compareWithRevision",
          "when": "activeWebviewPanelId == 'mdDesignDoc.preview' || activeCustomEditorId == 'mdDesignDoc.editor'",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "mdDesignDoc.openPreview",
          "when": "editorLangId == markdown"
        },
        {
          "command": "mdDesignDoc.openPreviewToSide",
          "when": "editorLangId == markdown"
        },
        {
          "command": "mdDesignDoc.exportHtml",
          "when": "editorLangId == markdown || activeWebviewPanelId == 'mdDesignDoc.preview' || activeCustomEditorId == 'mdDesignDoc.editor'"
        },
        {
          "command": "mdDesignDoc.useFullContentWidth",
          "when": "(activeWebviewPanelId == 'mdDesignDoc.preview' || activeCustomEditorId == 'mdDesignDoc.editor') && config.mdDesignDoc.limitContentWidth"
        },
        {
          "command": "mdDesignDoc.limitContentWidth",
          "when": "(activeWebviewPanelId == 'mdDesignDoc.preview' || activeCustomEditorId == 'mdDesignDoc.editor') && !config.mdDesignDoc.limitContentWidth"
        },
        {
          "command": "mdDesignDoc.toggleTheme",
          "when": "activeWebviewPanelId == 'mdDesignDoc.preview' || activeCustomEditorId == 'mdDesignDoc.editor' || activeWebviewPanelId == 'mdDesignDoc.designDocs'"
        },
        {
          "command": "mdDesignDoc.compareWithRevision",
          "when": "editorLangId == markdown || activeWebviewPanelId == 'mdDesignDoc.preview' || activeCustomEditorId == 'mdDesignDoc.editor'"
        },
        {
          "command": "mdDesignDoc.refreshDesignDocs",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "mdDesignDoc.openDesignDocInEditor",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "command": "mdDesignDoc.exportHtml",
          "when": "webviewId == 'mdDesignDoc.preview' || webviewId == 'mdDesignDoc.editor'"
        },
        {
          "command": "mdDesignDoc.compareWithRevision",
          "when": "webviewId == 'mdDesignDoc.preview' || webviewId == 'mdDesignDoc.editor'"
        }
      ],
      "view/title": [
        {
          "command": "mdDesignDoc.showDesignDocs",
          "when": "view == mdDesignDoc.designDocs",
          "group": "navigation@1"
        },
        {
          "command": "mdDesignDoc.refreshDesignDocs",
          "when": "view == mdDesignDoc.designDocs",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "mdDesignDoc.openDesignDocInEditor",
          "when": "view == mdDesignDoc.designDocs && viewItem == designDoc",
          "group": "inline"
        },
        {
          "command": "mdDesignDoc.openDesignDocInEditor",
          "when": "view == mdDesignDoc.designDocs && viewItem == designDoc",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "%displayName%",
      "properties": {
        "mdDesignDoc.splitMinWidth": {
          "type": "number",
          "default": 1000,
          "minimum": 0,
          "description": "%mdDesignDoc.splitMinWidth.description%"
        },
        "mdDesignDoc.limitContentWidth": {
          "type": "boolean",
          "default": true,
          "description": "%mdDesignDoc.limitContentWidth.description%"
        },
        "mdDesignDoc.stickyTableHeader": {
          "type": "boolean",
          "default": true,
          "description": "%mdDesignDoc.stickyTableHeader.description%"
        },
        "mdDesignDoc.tableTreeHighlight": {
          "type": "boolean",
          "default": true,
          "description": "%mdDesignDoc.tableTreeHighlight.description%"
        },
        "mdDesignDoc.syncEditor": {
          "type": "boolean",
          "default": true,
          "description": "%mdDesignDoc.syncEditor.description%"
        },
        "mdDesignDoc.toc": {
          "type": "boolean",
          "default": true,
          "description": "%mdDesignDoc.toc.description%"
        },
        "mdDesignDoc.headingNumbers": {
          "type": "boolean",
          "default": true,
          "description": "%mdDesignDoc.headingNumbers.description%"
        },
        "mdDesignDoc.frontMatter": {
          "type": "boolean",
          "default": true,
          "description": "%mdDesignDoc.frontMatter.description%"
        },
        "mdDesignDoc.diagramLook": {
          "type": "string",
          "enum": [
            "neo",
            "classic"
          ],
          "enumDescriptions": [
            "%mdDesignDoc.diagramLook.neo%",
            "%mdDesignDoc.diagramLook.classic%"
          ],
          "default": "neo",
          "description": "%mdDesignDoc.diagramLook.description%"
        },
        "mdDesignDoc.theme": {
          "type": "string",
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "enumDescriptions": [
            "%mdDesignDoc.theme.auto%",
            "%mdDesignDoc.theme.light%",
            "%mdDesignDoc.theme.dark%"
          ],
          "default": "auto",
          "description": "%mdDesignDoc.theme.description%"
        },
        "mdDesignDoc.diagnostics": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "%mdDesignDoc.diagnostics.description%"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "screenshots": "node esbuild.mjs && esbuild scripts/screenshots.ts --bundle --platform=node --format=cjs --external:playwright-core --log-level=warning --outfile=dist/screenshots.cjs && node dist/screenshots.cjs",
    "vscode:prepublish": "node esbuild.mjs --production",
    "package": "vsce package --no-dependencies",
    "npm:package": "node esbuild.mjs --production && node scripts/npm-package.mjs",
    "skill:package": "node scripts/skill-package.mjs",
    "pages": "node scripts/pages.mjs",
    "desktop:build": "node esbuild.mjs --desktop --production",
    "desktop:dev": "tauri dev",
    "desktop:bundle": "tauri build",
    "notices": "node scripts/third-party-notices.mjs",
    "desktop:licenses": "cargo about generate --locked --manifest-path desktop/src-tauri/Cargo.toml -o desktop/src-tauri/ThirdPartyLicenses.txt desktop/src-tauri/about.hbs",
    "tauri": "tauri",
    "prepack": "node esbuild.mjs --production",
    "prepublishOnly": "node -e \"console.error('The npm package is published from .work/npm: pnpm npm:package, then npm publish .work/npm.'); process.exit(1)\""
  },
  "dependencies": {
    "playwright-core": "^1.64.0"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/cli": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@types/vscode": "~1.100.0",
    "@vscode/vsce": "^4.0.0",
    "diff": "^8.0.4",
    "dompurify": "^3.4.16",
    "esbuild": "^0.28.2",
    "gifenc": "^1.0.3",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.2",
    "markdown-it-footnote": "^4.0.0",
    "mermaid": "^12.1.0",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "yazl": "^2.5.1"
  },
  "packageManager": "pnpm@12.3.4"
}
