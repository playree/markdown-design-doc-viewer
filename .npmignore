# npm パッケージ（CLI の md-design-doc）に入れるファイルのホワイトリスト。
# vsix に入れるファイルは .vscodeignore（vsce は package.json の files と .vscodeignore を併用できない）。
# package.json・README・LICENSE は npm が常に入れる。
/*
!/dist/
/dist/*
!/dist/cli.js
!/dist/webview.js
!/dist/webview.css
!/dist/export.js
!/dist/export.css
!/l10n/
!/ThirdPartyNotices.txt
